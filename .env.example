OPENLIBING_BASE_URL_PROD="https://hidevlab.huawei.com"
OPENLIBING_REFERER_PROD="https://hidevlab.huawei.com"
OPENLIBING_BASE_URL_BETA="https://apigw-beta.huawei.com/api/beta"
OPENLIBING_REFERER_BETA="https://lab-beta.rnd.huawei.com/"
OPENLIBING_BASE_URL_ALPHA="https://apigw-beta.huawei.com/api/alpha"

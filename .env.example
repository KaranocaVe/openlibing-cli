# Deep link source of truth. The CLI derives OPENLIBING_SESSION_ID,
# OPENLIBING_DEFAULT_ENV_ID, OPENLIBING_USER_ID, and OPENLIBING_AUTH_TYPE.
OPENLIBING_VSCODE_URI="vscode://openlibing.resourcemanager/connect?authTicket%3DSESSION_TOKEN_EXAMPLE%26userId%3Duser_example%26envId%3Denv-1234567890%26authType%3Dhidevlab"
